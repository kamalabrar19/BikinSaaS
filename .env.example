# Nomor WhatsApp tujuan, format internasional tanpa tanda plus.
# WAJIB diisi. Kalau kosong, tombol WhatsApp akan jatuh ke email
# dan tidak mengarah ke nomor mana pun.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Email yang dipakai sebagai jalur cadangan saat WhatsApp belum diatur.
NEXT_PUBLIC_CONTACT_EMAIL=

# URL publik website. Dipakai untuk metadataBase, hreflang, OG, dan sitemap.
# Tanpa garis miring di akhir.
NEXT_PUBLIC_SITE_URL=https://bikinsaas.com

# Opsional: webhook penerima data lead (POST JSON). Kosongkan jika tidak dipakai.
NEXT_PUBLIC_LEAD_WEBHOOK_URL=

# Opsional: link sosial untuk footer. Hanya tampil jika diisi.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=

# ---------------------------------------------------------------- admin panel
# Panel di /admin: tidak ditautkan dari mana pun dan meminta agar tidak
# diindeks. Isi ketiganya atau panel menolak diakses.
# Buat hash password + session secret dengan: npm run admin:password
# Nomor WhatsApp dan email di atas juga bisa diisi dari panel.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
